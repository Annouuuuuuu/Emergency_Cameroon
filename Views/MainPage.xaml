<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Emergency_cameroun.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White"
    Padding="0"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <Grid
        x:Name="Viewport"
        Style="{StaticResource PhoneViewportStyle}"
        SizeChanged="OnViewportSizeChanged"
        >
        <Border
            x:Name="PresentationFrame"
            Style="{StaticResource PhoneDisplayFrameStyle}">
            <ContentView
                x:Name="ScreenHost"
                Style="{StaticResource PhoneScreenHostStyle}" />
        </Border>
    </Grid>
</ContentPage>
